# Sao chép file này thành .env rồi điền giá trị thật.

# local | production
APP_ENV=local
# true: hiện lỗi PHP ra màn hình (chỉ dùng khi dev). Chạy thật: false
APP_DEBUG=true

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lego_shop
DB_USER=root
DB_PASS=

# ---------- Session ----------
# Tự đăng xuất sau bao nhiêu PHÚT không thao tác
SESSION_IDLE_MINUTES=120

# ---------- Thanh toán VietQR ----------
# Tạo key ngẫu nhiên: php -r "echo bin2hex(random_bytes(24));"
PAYMENT_WEBHOOK_KEY=
